# =============================================================================
# ResQShield / ResQNet — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# Do NOT commit .env — it is git-ignored.
# =============================================================================

# --- Application ---
RESQ_ENV=development
RESQ_APP_NAME=ResQShield

# --- API Server ---
RESQ_API_HOST=127.0.0.1
RESQ_API_PORT=8000
RESQ_API_PREFIX=/api/v1

# --- Database (PostGIS / TimescaleDB) ---
# Async URL for FastAPI application runtime
RESQ_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/resqshield
# Sync URL for Alembic database migrations
RESQ_DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/resqshield

# --- MQTT Broker ---
# Not connected in B01/B02; placeholder only.
RESQ_MQTT_BROKER_HOST=localhost
RESQ_MQTT_BROKER_PORT=1883
RESQ_MQTT_BASE_TOPIC=resqshield/

# --- Object Storage (S3-compatible) ---
RESQ_STORAGE_ENDPOINT=http://localhost:9000
RESQ_STORAGE_BUCKET=resqshield-data
RESQ_STORAGE_BASE_PREFIX=

# --- ML / Artifacts ---
RESQ_MODEL_ARTIFACT_DIR=./artifacts

# --- Pilot Configuration ---
# Default geography frozen by T99/T01; deployments may override through environment variables.
# Keep pilot and holdout identifiers distinct.
RESQ_PILOT_ID=HP_MANDI_PANDOH_CORRIDOR
RESQ_HOLDOUT_ID=UK_DEHRADUN_RAIPUR_KUMALDA
